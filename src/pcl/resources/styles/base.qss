/* PCL2 Python 版全局样式模板，%TOKEN% 由 theme.py 渲染 */

QWidget {
    color: %TEXT%;
    font-size: %FONT_SIZE%;
    selection-background-color: %ACCENT%;
    selection-color: #FFFFFF;
}

QMainWindow, #RootSurface {
    background: %BG%;
}

#ContentArea { background: transparent; }

QScrollArea,
QScrollArea > QWidget > QWidget,
QAbstractScrollArea::viewport {
    background: transparent;
    border: none;
}

/* ---------- 标题栏 ---------- */
#TitleBar { background: transparent; }
#TitleBarText { color: %TEXT%; font-size: %FONT_SIZE_LARGE%; font-weight: 600; }
#TitleBarSubtitle { color: %TEXT_MUTED%; font-size: %FONT_SIZE_SMALL%; }

/* ---------- 侧边导航 ---------- */
#Sidebar {
    background: %SURFACE%;
    border-right: 1px solid %BORDER_SOFT%;
}
#NavButton { background: transparent; border: none; border-radius: 12px; }
#NavButton:hover { background: %SURFACE_HOVER%; }
#NavButton:checked { background: %ACCENT_SOFT%; }

/* ---------- 卡片 ---------- */
#Card {
    background: %SURFACE%;
    border: 1px solid %BORDER_SOFT%;
    border-radius: %RADIUS%;
}
#CardFlat {
    background: %SURFACE_ALT%;
    border: 1px solid transparent;
    border-radius: %RADIUS%;
}

/* ---------- 文本 ---------- */
QLabel#PageTitle { font-size: %FONT_SIZE_TITLE%; font-weight: 700; color: %TEXT%; letter-spacing: 0.2px; }
QLabel#PageSubtitle { color: %TEXT_MUTED%; font-size: %FONT_SIZE%; }
QLabel#SectionTitle { font-size: %FONT_SIZE_LARGE%; font-weight: 600; }
QLabel#Muted { color: %TEXT_MUTED%; font-size: %FONT_SIZE_SMALL%; }
QLabel#Tag {
    background: %ACCENT_SOFT%; color: %ACCENT%;
    border-radius: 9px; padding: 3px 10px;
    font-size: %FONT_SIZE_SMALL%; font-weight: 600;
}
QLabel#TagNeutral {
    background: %SURFACE_ALT%; color: %TEXT_MUTED%;
    border-radius: 9px; padding: 3px 10px;
    font-size: %FONT_SIZE_SMALL%;
}

/* ---------- 按钮 ---------- */
QPushButton {
    background: %SURFACE%;
    color: %TEXT%;
    border: 1px solid %BORDER_STRONG%;
    border-radius: 9px;
    padding: 7px 15px;
    font-size: %FONT_SIZE%;
}
QPushButton:hover { background: %SURFACE_HOVER%; border-color: %ACCENT%; color: %ACCENT%; }
QPushButton:pressed { background: %BG_ALT%; }
QPushButton:disabled { color: %TEXT_DISABLED%; background: %SURFACE_ALT%; border-color: %BORDER_SOFT%; }

QPushButton#Primary {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 %ACCENT_HOVER%, stop:1 %ACCENT%);
    color: #FFFFFF; border: none; font-weight: 600;
}
QPushButton#Primary:hover { background: %ACCENT_HOVER%; }
QPushButton#Primary:pressed { background: %ACCENT_PRESSED%; }
QPushButton#Danger { background: transparent; color: %DANGER%; border: 1px solid %DANGER%; }
QPushButton#Ghost { background: transparent; border: 1px solid transparent; color: %TEXT_MUTED%; }
QPushButton#Ghost:hover { background: %SURFACE_HOVER%; color: %TEXT%; }

/* ---------- 输入 ---------- */
QLineEdit, QComboBox, QSpinBox, QPlainTextEdit, QTextEdit {
    background: %SURFACE_ALT%;
    border: 1px solid %BORDER_SOFT%;
    border-radius: 9px;
    padding: 7px 11px;
    color: %TEXT%;
    selection-background-color: %ACCENT%;
}
QLineEdit:hover, QComboBox:hover, QSpinBox:hover { border-color: %BORDER_STRONG%; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QPlainTextEdit:focus {
    border-color: %ACCENT%;
    background: %SURFACE%;
}
QComboBox::drop-down { border: none; width: 22px; }
QComboBox QAbstractItemView {
    background: %SURFACE%;
    border: 1px solid %BORDER_SOFT%;
    border-radius: 10px;
    padding: 5px;
    outline: none;
}
QComboBox QAbstractItemView::item { padding: 7px 10px; border-radius: 6px; }
QComboBox QAbstractItemView::item:hover,
QComboBox QAbstractItemView::item:selected { background: %ACCENT_SOFT%; color: %ACCENT%; }

QSpinBox { padding-right: 10px; }
QSpinBox::up-button, QSpinBox::down-button { width: 0; height: 0; border: none; background: transparent; }
QSpinBox::up-arrow, QSpinBox::down-arrow { width: 0; height: 0; image: none; }

/* ---------- 列表 ---------- */
QListWidget, QTreeWidget, QTableWidget {
    background: transparent; border: none; outline: none;
}
QListWidget::item {
    border-radius: 9px;
    padding: 7px 10px;
    margin: 1px 0;
    color: %TEXT%;
}
QListWidget::item:hover { background: %SURFACE_HOVER%; }
QListWidget::item:selected { background: %ACCENT_SOFT%; color: %TEXT%; }

/* ---------- 滚动条 ---------- */
QScrollBar:vertical { background: transparent; width: 9px; margin: 2px; }
QScrollBar::handle:vertical { background: %SCROLL%; border-radius: 4px; min-height: 36px; }
QScrollBar::handle:vertical:hover { background: %ACCENT%; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { height: 0; background: none; }
QScrollBar:horizontal { background: transparent; height: 9px; margin: 2px; }
QScrollBar::handle:horizontal { background: %SCROLL%; border-radius: 4px; min-width: 36px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { width: 0; background: none; }

/* ---------- 标签页 ---------- */
QTabWidget::pane { border: none; background: transparent; top: -1px; }
QTabBar::tab {
    background: transparent;
    color: %TEXT_MUTED%;
    padding: 7px 14px;
    margin-right: 6px;
    border-radius: 9px;
    font-size: %FONT_SIZE%;
}
QTabBar::tab:hover { background: %SURFACE_HOVER%; color: %TEXT%; }
QTabBar::tab:selected {
    background: %ACCENT_SOFT%;
    color: %ACCENT%;
    font-weight: 600;
}

/* ---------- 菜单 ---------- */
QMenu {
    background: %SURFACE%;
    border: 1px solid %BORDER_SOFT%;
    border-radius: 11px;
    padding: 6px;
}
QMenu::item { padding: 7px 24px 7px 14px; border-radius: 7px; color: %TEXT%; }
QMenu::item:selected { background: %ACCENT_SOFT%; color: %ACCENT%; }
QMenu::separator { height: 1px; background: %BORDER_SOFT%; margin: 4px 8px; }

/* ---------- 其他 ---------- */
QToolTip {
    background: %SURFACE%; color: %TEXT%;
    border: 1px solid %BORDER_SOFT%;
    border-radius: 8px; padding: 6px 9px;
}
QSplitter::handle { background: transparent; }
QCheckBox { spacing: 8px; color: %TEXT%; }
QCheckBox::indicator {
    width: 16px; height: 16px;
    border-radius: 5px;
    border: 1px solid %BORDER_STRONG%;
    background: %SURFACE_ALT%;
}
QCheckBox::indicator:checked { background: %ACCENT%; border-color: %ACCENT%; }
QProgressBar {
    background: %SURFACE_ALT%; border: none;
    border-radius: 3px; height: 6px;
    text-align: center; color: transparent;
}
QProgressBar::chunk { border-radius: 3px; background: %ACCENT%; }
